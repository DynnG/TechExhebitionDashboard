# ==============================================================================
# Lifewood Tech Exhibition Intelligence Platform - Environment Variables Template
# ==============================================================================
# Duplicate this file as .env.local (for Next.js) and .env (for the crawler engine).
# Fill in your API keys and configuration values before running the app.

# ------------------------------------------------------------------------------
# 1. Next.js & Authentication Configuration
# ------------------------------------------------------------------------------
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="lifewood-secret-key-super-secure-2026-change-in-production"
NEXT_PUBLIC_APP_NAME="Lifewood Exhibition Dashboard"

# ------------------------------------------------------------------------------
# 2. Database Configuration
# ------------------------------------------------------------------------------
# By default, local development uses SQLite (prisma/dev.db) defined in schema.prisma.
# If connecting to PostgreSQL in production, set DATABASE_URL:
DATABASE_URL="file:./dev.db"

# ------------------------------------------------------------------------------
# 3. AI Discovery & Crawler Microservice (server.mjs / port 5000)
# ------------------------------------------------------------------------------
# Port for the Express crawler microservice
PORT=5000

# Apify API Token (required for Apify Google Search discovery scraping)
# Get your token at https://console.apify.com/account#/integrations
APIFY_TOKEN=""

# Google Gemini API Key (required for AI event extraction, classification & scoring)
# Get your key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=""

# Gemini model used for extraction (fallback tiers automatically handled in crawler)
GEMINI_MODEL="gemini-2.5-flash"

# Optional: URL of the crawler microservice (defaults to http://localhost:5000/api/crawl-events)
CRAWLER_ENGINE_URL="http://localhost:5000/api/crawl-events"

